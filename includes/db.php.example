<?php
/**
 * Database Configuration
 * 
 * INSTRUCTIONS:
 * 1. Copy this file to db.php
 * 2. Update the values below with your actual database credentials
 * 3. Save the file
 */

// Database Configuration
define('DB_HOST', 'localhost');              // Usually 'localhost' - check with your hosting provider
define('DB_NAME', 'your_database_name');     // Your database name (e.g., schoolpulse_schoolpulse_db)
define('DB_USER', 'your_database_user');     // Your database username (e.g., schoolpulse_user)
define('DB_PASS', 'your_database_password'); // Your database password
define('DB_CHARSET', 'utf8mb4');             // Character set - don't change

// Create PDO connection
try {
    $pdo = new PDO(
        "mysql:host=".DB_HOST.";dbname=".DB_NAME.";charset=".DB_CHARSET,
        DB_USER, DB_PASS,
        [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES   => false,
        ]
    );
} catch (PDOException $e) {
    // Log error (don't show details to users in production)
    error_log("Database connection failed: " . $e->getMessage());
    
    // Show generic error to users
    http_response_code(500);
    die(json_encode(['error' => 'Database connection failed']));
}
